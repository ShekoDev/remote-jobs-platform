# PostgreSQL connection (see docker-compose.yml for a local instance)
DATABASE_URL="postgresql://remote:remote@localhost:5432/remote_jobs?schema=public"

# Ingestion
INGEST_CRON="*/30 * * * *"        # pull new jobs from all sources every 30 minutes
VERIFY_CRON="0 */2 * * *"         # re-check open jobs every 2 hours
VERIFY_BATCH_SIZE=200
JOB_MAX_AGE_DAYS=45               # anything older is auto-expired

# Optional: enable/disable individual sources (comma separated ids)
# ENABLED_SOURCES="remotive,remoteok,jobicy,arbeitnow,himalayas,weworkremotely"
